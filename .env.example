# SignalFold Environment Configuration
# =========================================================================
# WARNING: All variables starting with VITE_ are exposed to the browser!
# SECRETS (Base44 and DeepSeek secrets) MUST NEVER use VITE_ variables.
# Private secrets belong strictly in the backend/server configuration.
# =========================================================================

# App Configuration
VITE_APP_NAME="SignalFold"

# Data Mode
# "mock" is the default frontend mode for standalone preview and QA testing.
VITE_DATA_MODE="mock"

# Base44 public application configuration
# The app ID is public configuration, not a secret. Leave it empty in mock mode.
VITE_BASE44_APP_ID=""
VITE_BASE44_USE_LOCAL_DEV="false"
VITE_BASE44_LOCAL_SERVER_URL="http://localhost:4400"
