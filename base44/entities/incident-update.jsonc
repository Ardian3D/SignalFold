{
  "name": "IncidentUpdate",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string" },
    "incident_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["incident_created", "incident_seeded", "incident_acknowledged", "status_changed", "severity_changed", "commander_assigned", "commander_reassigned", "commander_unassigned", "internal_note_added", "public_update_published", "incident_resolved", "incident_closed", "incident_reopened", "task_created", "task_assigned", "task_reassigned", "task_claimed", "task_unclaimed", "task_updated", "task_blocked", "task_unblocked", "task_completed", "task_cancelled", "ai_analysis_requested", "ai_analysis_completed", "ai_analysis_failed"] },
    "actor_user_id": { "type": "string" },
    "actor_type": { "type": "string", "enum": ["user", "system", "ai"] },
    "visibility": { "type": "string", "enum": ["internal", "public"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "metadata": { "type": "object", "properties": { "code": { "type": "string", "maxLength": 32 }, "status": { "type": "string", "maxLength": 32 }, "previous_status": { "type": "string", "maxLength": 32 }, "new_status": { "type": "string", "maxLength": 32 }, "severity": { "type": "string", "maxLength": 8 }, "previous_severity": { "type": "string", "maxLength": 8 }, "new_severity": { "type": "string", "maxLength": 8 }, "reason": { "type": "string", "maxLength": 1000 }, "task_id": { "type": "string", "maxLength": 128 }, "task_title": { "type": "string", "maxLength": 160 }, "priority": { "type": "string", "maxLength": 16 }, "assignee_user_id": { "type": "string", "maxLength": 128 }, "previous_assignee_user_id": { "type": "string", "maxLength": 128 }, "commander_user_id": { "type": "string", "maxLength": 128 }, "previous_commander_user_id": { "type": "string", "maxLength": 128 }, "root_cause_known": { "type": "string", "maxLength": 16 }, "recovery_verified": { "type": "boolean" }, "open_critical_tasks": { "type": "integer" }, "override_used": { "type": "boolean" }, "override_reason": { "type": "string", "maxLength": 1000 }, "ai_assisted": { "type": "boolean" }, "ai_run_id": { "type": "string", "maxLength": 128 }, "model": { "type": "string", "maxLength": 120 }, "prompt_version": { "type": "string", "maxLength": 40 }, "feature": { "type": "string", "maxLength": 40 }, "severity_suggestion": { "type": "string", "maxLength": 8 }, "error_code": { "type": "string", "maxLength": 80 }, "cache_hit": { "type": "boolean" }, "review_status": { "type": "string", "maxLength": 16 }, "blocking_reason": { "type": "string", "maxLength": 1000 }, "completion_note": { "type": "string", "maxLength": 2000 }, "request_id": { "type": "string", "maxLength": 128 } } },
    "occurred_at": { "type": "string", "format": "date-time" },
    "is_demo": { "type": "boolean", "default": false },
    "request_id": { "type": "string", "maxLength": 128 }
  },
  "required": ["organization_id", "incident_id", "event_type", "actor_type", "visibility", "message", "occurred_at", "is_demo"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
