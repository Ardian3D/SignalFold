{
  "name": "Incident",
  "type": "object",
  "properties": {
    "organization_id": { "type": "string" },
    "code": { "type": "string", "maxLength": 32 },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 5000 },
    "source": { "type": "string", "enum": ["manual", "demo", "api"] },
    "service_id": { "type": "string" },
    "reporter_user_id": { "type": "string" },
    "commander_user_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["SEV1", "SEV2", "SEV3", "SEV4"] },
    "severity_source": { "type": "string", "enum": ["human", "ai_suggested", "rule_baseline"] },
    "status": { "type": "string", "enum": ["reported", "triaging", "investigating", "identified", "monitoring", "resolved", "closed"] },
    "category": { "type": "string", "maxLength": 80 },
    "impact_summary": { "type": "string", "maxLength": 1000 },
    "affected_users_estimate": { "type": "integer", "minimum": 0 },
    "observed_start_at": { "type": "string", "format": "date-time" },
    "reported_at": { "type": "string", "format": "date-time" },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "resolution_summary": { "type": "string", "maxLength": 2000 },
    "recovery_verified": { "type": "boolean", "default": false },
    "remaining_risk": { "type": "string", "maxLength": 1000 },
    "ai_summary": { "type": "string", "maxLength": 2000 },
    "ai_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ai_risk_flags": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 80 } },
    "ai_analysis_version": { "type": "string", "maxLength": 40 },
    "ai_last_analyzed_at": { "type": "string", "format": "date-time" },
    "public_visibility": { "type": "string", "enum": ["private", "public"], "default": "private" },
    "public_summary": { "type": "string", "maxLength": 1000 },
    "is_demo": { "type": "boolean", "default": false },
    "reopened_count": { "type": "integer", "minimum": 0, "default": 0 },
    "request_id": { "type": "string", "maxLength": 128 }
  },
  "required": ["organization_id", "code", "title", "description", "source", "reporter_user_id", "severity", "severity_source", "status", "reported_at", "recovery_verified", "public_visibility", "is_demo", "reopened_count"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
